# UniArena backend: production settings
# Copy these into your host's environment/secrets screen. Never commit real values.

# --- Runtime ---
NODE_ENV=production
PORT=5000
# Number of proxies in front of the app (Railway/Vercel/nginx = 1), so each person's real IP is used for rate limits
TRUST_PROXY_HOPS=1

# --- Database ---
# The LIMITED app user (uniarena_app): read/write on tables only, cannot drop or alter anything
DATABASE_URL=postgresql://uniarena_app:PASSWORD@HOST:5432/uniarena?schema=public
# The OWNER user is used only when deploying migrations and is NOT an app setting. Run:
#   DATABASE_URL="<owner url>" npx prisma migrate deploy
# Keep the owner URL out of the running app's environment.

# --- Sign-in security ---
# Must be identical to NEXTAUTH_SECRET on the frontend. Generate with: openssl rand -base64 32
# Never reuse the development value. Changing it signs everyone out.
NEXTAUTH_SECRET=

# --- Registration ---
ALLOWED_EMAIL_DOMAIN=mylife.mku.ac.ke

# --- URLs ---
# The real HTTPS address of the frontend (used for CORS and links in emails)
FRONTEND_URL=https://your-frontend-domain

# --- Email (Brevo) ---
BREVO_API_KEY=
# Must be a verified sender in Brevo. Use an address on your own domain before launch.
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=UniArena

# --- Uploads (logos and banners) ---
# Local disk only survives on a host with a persistent volume. Most hosts wipe disk on deploy,
# so either mount a volume at this path or move uploads to cloud storage before launch.
UPLOAD_DIR=/data/uploads