# Copy the right parts into backend/.env and frontend/.env.local. Never commit real values.

# ---------- Backend (backend/.env) ----------
NODE_ENV=development
PORT=5000

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/uniarena?schema=public

# Secret that signs the sign-in cookie. Generate with: openssl rand -base64 32
# Must be identical on the backend and the frontend.
NEXTAUTH_SECRET=

# Optional but recommended: a separate secret for the API token (same value on backend and frontend)
API_JWT_SECRET=

# Only emails ending in this domain can register
ALLOWED_EMAIL_DOMAIN=mylife.mku.ac.ke

# Where the frontend lives (used for CORS and links in emails)
FRONTEND_URL=http://localhost:3000

# Set to 1 when the API runs behind a hosting proxy (Railway, Vercel, nginx). Leave 0 on your own computer.
TRUST_PROXY_HOPS=0

# Email (Brevo). Without a key, emails are printed in the terminal.
BREVO_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=UniArena

# Image storage (Supabase). Without these, images are saved in the uploads folder (development only).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=uniarena-media
UPLOAD_DIR=

# ---------- Frontend (frontend/.env.local) ----------
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXTAUTH_URL=http://localhost:3000
# NEXTAUTH_SECRET and API_JWT_SECRET: the same values as the backend
